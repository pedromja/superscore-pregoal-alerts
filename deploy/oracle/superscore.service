[Unit]
Description=SuperScore pre-goal/pre-corner alerts (UI + API + poller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superscore
Group=superscore
WorkingDirectory=/opt/superscore/current
# Secrets + flags (POLLER_ENABLED, TELEGRAM_ENABLED, PUBLIC_URL, ...). 600, never committed.
EnvironmentFile=/etc/superscore/superscore.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=TZ=UTC
ExecStart=/usr/bin/node /opt/superscore/current/dist-server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/superscore
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
