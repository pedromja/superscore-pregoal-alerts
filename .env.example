# Web Push (npm run vapid:generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost

# Servidor / poller (Railway/Render injectam PORT)
PORT=8080
POLLER_ENABLED=1
POLLER_REGION=ro
# alias aceite: POLL_REGION=ro
POLLER_INTERVAL_MS=45000
LEARN_WINDOW=5
LEARN_LONG_CAP=15
# Propostas de aprendizagem NUNCA se aplicam sozinhas. Só o botão / API com confirm:true.
LEARN_AUTO_APPLY=0
LEARN_AUTO_MIN_OUTCOMES=50
DATA_DIR=data
