# Telegram (canal principal de avisos). Nunca commitar tokens reais.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=1   # default on quando token+chat estão definidos; 0 desliga
# TELEGRAM_TIMEOUT_MS=9000
# TELEGRAM_RETRY_MAX_ATTEMPTS=4   # tentativas totais (1.ª + retries) em falhas transitórias
# TELEGRAM_RETRY_BASE_MS=2000     # backoff 2s, 6s, 18s (429 usa retry_after)
# TELEGRAM_RETRY_MAX_AGE_MS=60000 # nenhuma tentativa depois disto (lead expira)
# TELEGRAM_WEBHOOK_SECRET=   # opcional; senão deriva do bot token. Header X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_UPDATES=webhook   # webhook (default) | poll | off
# TELEGRAM_INLINE_EDITS=1        # 1 (default): resultado/odds/VOID editados na mensagem original; 0 = respostas novas (legado)
# TELEGRAM_ODDS_EDIT_MAX_MS=90000 # janela para acrescentar a linha 💰 Odd após o envio (sem odds na janela = nada)
# VOID_CHECK=1                    # 1 (default): verificação VOID depois do envio; 0 desliga
# VOID_CHECK_DELAY_MS=15000       # atraso da verificação VOID (1000–120000)
# TELEGRAM_LEAGUE_STATS=1        # 1 (default): linha "📊 Liga (golos): 4/6 · 67 %" no alerta; 0 desliga
# TELEGRAM_LEAGUE_STATS_MIN=3    # mínimo de alertas resolvidos (não VOID) da liga+mercado para mostrar a linha
# PUBLIC_URL=https://web-production-837b3.up.railway.app
# Filtro de qualidade (só decide o que notifica; alertas/aprendizagem intactos)
# on (default) | off
QUALITY_OVERLAY=on

# Web Push (dormente). WEB_PUSH_ENABLED=1 para reactivar.
# WEB_PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost

# Servidor / poller (Railway/Render injectam PORT)
PORT=8080
# 0/false/off = arranca sem poller (cutover seguro / restauro de data/)
POLLER_ENABLED=1
POLLER_REGION=ro
# alias aceite: POLL_REGION=ro
# Defaults match Railway (15000 / 32 / 8). Env overrides always win.
POLLER_INTERVAL_MS=15000
# POLLER_LIVE_LIMIT=32
# POLLER_CONCURRENCY=8
# POLLER_IN_WINDOW_CONCURRENCY=12
# POLLER_FIXTURE_TIMEOUT_MS=12000
# POLLER_TICK_WATCHDOG_MS=80000
# POLLER_JSON_BACKOFF_MAX_MS=600000
# Live Telegram/push: never notify without ≥1′ clock lead (locked backtest).
# MIN_NOTIFY_LEAD_MIN=1
LEARN_WINDOW=5
LEARN_LONG_CAP=15
# Propostas de aprendizagem NUNCA se aplicam sozinhas. Só o botão / API com confirm:true.
LEARN_AUTO_APPLY=0
LEARN_AUTO_MIN_OUTCOMES=50
DATA_DIR=data

# Odds SokkerPro (público, sem login). Default ON. 0 desliga. Timeouts/404 nunca partem o poller.
SOKKERPRO_ODDS=1
# SOKKERPRO_M2_URL=https://m2.sokkerpro.com
# Mini board ~1 MB: 25s. Preodds por jogo: 8s.
# SOKKERPRO_BOARD_TIMEOUT_MS=25000
# SOKKERPRO_PREODDS_TIMEOUT_MS=8000
# SOKKERPRO_BOARD_CACHE_MS=90000
